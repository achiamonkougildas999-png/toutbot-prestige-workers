async function countPending(env, userCode) {
  const row = await one(env, "SELECT COUNT(*) AS n FROM transactions WHERE user_id_code=? AND status='EN_ATTENTE'", [userCode]);
  return row ? row.n : 0;
}

async function requestDeposit(env, userCode, amount, phone) {
  if (await countPending(env, userCode) >= 5) throw new BusinessError("Tu as déjà 5 demandes en attente.");
  const ticket = newCode("DEP");
  await run(env,
    `INSERT INTO transactions (type, user_id_code, amount_requested, commission_taken, net_amount,
      user_reference_phone, status, ticket_code, created_at)
     VALUES ('DEPOT', ?, ?, 0, ?, ?, 'EN_ATTENTE', ?, ?)`,
    [userCode, amount, amount, phone, ticket, nowIso()]);
  return ticket;
}

async function requestWithdrawal(env, userCode, amount, phone) {
  if (await countPending(env, userCode) >= 5) throw new BusinessError("Tu as déjà 5 demandes en attente.");
  const commission = commissionFor(amount);
  const net = amount - commission;
  const ticket = newCode("RET");
  const res = await run(env, "UPDATE users SET balance = balance - ? WHERE user_id_code=? AND balance >= ?", [amount, userCode, amount]);
  if (res.meta.changes !== 1) throw new BusinessError("Solde insuffisant.");
  await run(env,
    `INSERT INTO transactions (type, user_id_code, amount_requested, commission_taken, net_amount,
      user_reference_phone, status, ticket_code, created_at)
     VALUES ('RETRAIT', ?, ?, ?, ?, ?, 'EN_ATTENTE', ?, ?)`,
    [userCode, amount, commission, net, phone, ticket, nowIso()]);
  return ticket;
}

function decisionText(tx, approve) {
  const ticket = tx.ticket_code, amount = fmtFcfa(tx.amount_requested);
  if (tx.type === "DEPOT") {
    return approve
      ? `✅ Ton dépôt de ${amount} (ticket ${ticket}) est validé. Ton solde est crédité.`
      : `❌ Ton dépôt de ${amount} (ticket ${ticket}) est refusé.`;
  }
  return approve
    ? `✅ Ton retrait de ${amount} (ticket ${ticket}) est validé : tu reçois ${fmtFcfa(tx.net_amount)}.`
    : `❌ Ton retrait de ${amount} (ticket ${ticket}) est refusé. Le montant est remboursé.`;
}

async function decideTransaction(env, txId, approve) {
  const tx = await one(env, "SELECT * FROM transactions WHERE id=?", [txId]);
  if (!tx) throw new BusinessError("Transaction introuvable.");
  if (tx.status !== "EN_ATTENTE") throw new BusinessError("Déjà traitée.");
  if (!["DEPOT", "RETRAIT"].includes(tx.type)) throw new BusinessError("Type invalide.");
  if (approve && tx.type === "DEPOT") {
    await run(env, "UPDATE users SET balance = balance + ? WHERE user_id_code=?", [tx.amount_requested, tx.user_id_code]);
  }
  if (!approve && tx.type === "RETRAIT") {
    await run(env, "UPDATE users SET balance = balance + ? WHERE user_id_code=?", [tx.amount_requested, tx.user_id_code]);
  }
  await run(env, "UPDATE transactions SET status=?, processed_at=? WHERE id=?", [approve ? "VALIDE" : "REJETE", nowIso(), txId]);
  await audit(env, "admin", approve ? "TX_VALIDE" : "TX_REJETE", `${tx.ticket_code} ${tx.type}`);
  await addDirectMessage(env, tx.user_id_code, "SYSTEM", decisionText(tx, approve), "user", tx.ticket_code);
  return tx.ticket_code;
}

async function activeSubscription(env, subscriberCode, creatorCode) {
  const row = await one(env, "SELECT expires_at FROM subscriptions WHERE subscriber_id=? AND creator_id=? AND expires_at > ?",
    [subscriberCode, creatorCode, nowIso()]);
  return row ? row.expires_at : null;
}

async function subscribeTo(env, subscriberCode, creatorCode) {
  if (subscriberCode === creatorCode) throw new BusinessError("Tu ne peux pas t'abonner à toi-même.");
  const creator = await one(env, "SELECT tier_price FROM users WHERE user_id_code=?", [creatorCode]);
  if (!creator) throw new BusinessError("Créateur introuvable.");
  const price = Number(creator.tier_price);
  const commission = commissionFor(price);
  const revenue = price - commission;
  const res = await run(env, "UPDATE users SET balance = balance - ? WHERE user_id_code=? AND balance >= ?", [price, subscriberCode, price]);
  if (res.meta.changes !== 1) throw new BusinessError(`Solde insuffisant : ${fmtFcfa(price)}.`);
  await run(env, "UPDATE users SET balance = balance + ? WHERE user_id_code=?", [revenue, creatorCode]);
  let start = new Date();
  const existing = await one(env, "SELECT expires_at FROM subscriptions WHERE subscriber_id=? AND creator_id=?", [subscriberCode, creatorCode]);
  if (existing) {
    const currentEnd = new Date(existing.expires_at.endsWith("Z") ? existing.expires_at : existing.expires_at + "Z");
    if (!Number.isNaN(currentEnd.getTime()) && currentEnd > start) start = currentEnd;
  }
  const expires = new Date(start.getTime() + CONFIG.SUBSCRIPTION_DAYS * 86400_000);
  const expiresIso = expires.toISOString().replace(/\.\d+Z$/, "");
  const stamp = nowIso();
  await run(env,
    `INSERT INTO subscriptions (subscriber_id, creator_id, expires_at, created_at) VALUES (?, ?, ?, ?)
     ON CONFLICT (subscriber_id, creator_id) DO UPDATE SET expires_at = excluded.expires_at`,
    [subscriberCode, creatorCode, expiresIso, stamp]);
  for (const [owner, kind] of [[subscriberCode, "ABONNEMENT"], [creatorCode, "REVENU"]]) {
    await run(env,
      `INSERT INTO transactions (type, user_id_code, amount_requested, commission_taken, net_amount,
        user_reference_phone, status, ticket_code, created_at, processed_at)
       VALUES (?, ?, ?, ?, ?, '-', 'VALIDE', ?, ?, ?)`,
      [kind, owner, price, commission, revenue, newCode("ABO"), stamp, stamp]);
  }
  return expiresIso.slice(0, 10);
}

async function addDirectMessage(env, userCode, sender, message, notify, ticket = "") {
  const readAdmin = notify === "admin" ? 0 : 1;
  const readUser = notify === "admin" ? 1 : 0;
  try {
