const hits = new Map();
function rateAllow(key, limit, windowMs) {
  const now = Date.now();
  if (hits.size > 5000) {
    for (const [k, arr] of hits) if (!arr.length || arr[arr.length - 1] < now - 3600_000) hits.delete(k);
  }
  let arr = hits.get(key);
  if (!arr) { arr = []; hits.set(key, arr); }
  while (arr.length && arr[0] <= now - windowMs) arr.shift();
  if (arr.length >= limit) return false;
  arr.push(now);
  return true;
}

