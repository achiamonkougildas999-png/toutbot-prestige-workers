    : `<div class="msg bot">Écris ici pour discuter avec l'admin.</div>`;
  return page(ctx, { title: "Messages Admin", body: `
<div class="card"><h2>Discussion privée</h2>
<div id="log" class="chatlog" data-last="\( {lastId}" data-mine="USER" data-poll="/messages/poll"> \){log}</div>
<form method="post" class="row" style="margin-top:.75rem;flex-wrap:nowrap">
  <input type="hidden" name="csrf_token" value="${escapeHtml(ctx.csrfToken)}">
  <input name="message" maxlength="1000" placeholder="Message…" required style="margin:0">
  <button type="submit" style="flex:0 0 auto">Envoyer</button>
</form></div>${chatJs(ctx.nonce)}` });
}

function tplAdminLogin(ctx) {
  return page(ctx, { title: "Admin", body: `
<div class="card"><h2>Administration</h2>
<form method="post"><input type="hidden" name="csrf_token" value="${escapeHtml(ctx.csrfToken)}">
<label>Mot de passe</label><input type="password" name="password" required>
<button type="submit">Entrer</button></form></div>` });
}

function tplAdminDashboard(ctx, { stats, pending }) {
  const pendingHtml = pending.length
    ? pending.map(t => `<tr>
<td>\( {escapeHtml(t.ticket_code)}</td><td> \){escapeHtml(t.type)}</td>
<td>\( {fmtFcfa(t.amount_requested)}</td><td> \){fmtFcfa(t.net_amount)}</td>
<td>${escapeHtml(t.user_reference_phone)}</td>
<td>
<form class="inline" method="post" action="/admin/tx/\( {t.id}/approve"><input type="hidden" name="csrf_token" value=" \){escapeHtml(ctx.csrfToken)}"><button>Valider</button></form>
<form class="inline" method="post" action="/admin/tx/\( {t.id}/reject"><input type="hidden" name="csrf_token" value=" \){escapeHtml(ctx.csrfToken)}"><button class="danger">Refuser</button></form>
</td></tr>`).join("")
    : `<tr><td colspan="6" class="mut">Rien en attente.</td></tr>`;
  return page(ctx, { title: "Admin", body: `
<div class="card"><h2>Tableau de bord</h2>
<p>${stats.users} membre(s) — ${fmtFcfa(stats.total)} — ${stats.pending} en attente</p>
<p><a style="color:var(--gold)" href="/admin/messages">💬 Discussions</a> ·
<a style="color:var(--gold)" href="/admin/ia">🔧 Test IA</a></p>
<form method="post" action="/admin/logout"><input type="hidden" name="csrf_token" value="${escapeHtml(ctx.csrfToken)}">
<button class="ghost">Quitter</button></form></div>
<div class="card"><h3>Dépôts / retraits</h3><div class="scroll"><table>
<tr><th>Ticket</th><th>Type</th><th>Montant</th><th>Net</th><th>Numéro</th><th></th></tr>${pendingHtml}
</table></div></div>` });
}

function tplAdminMessages(ctx, { users }) {
  const usersHtml = users.length
    ? users.map(u => `<p><a style="color:var(--gold)" href="/admin/chat/${escapeHtml(u.user_id_code)}">
      \( {escapeHtml(u.phone_or_pseudo)} ( \){escapeHtml(u.user_id_code)})</a>
      \( {u.unread ? ` — <b> \){u.unread} non lu(s)</b>` : ""}</p>`).join("")
    : `<p class="mut">Aucune discussion.</p>`;
  return page(ctx, { title: "Discussions", body: `
<div class="card"><h2>Discussions privées</h2>${usersHtml}</div>
<p><a style="color:var(--gold)" href="/admin">← Retour</a></p>` });
}

function tplAdminChat(ctx, { user, messages, lastId }) {
  const log = messages.length ? messages.map(m => bubble(m, "ADMIN")).join("")
    : `<div class="msg bot">Aucun message.</div>`;
  return page(ctx, { title: "Chat", body: `
<div class="card"><h2>Discussion avec ${escapeHtml(user.phone_or_pseudo)}</h2>
<div id="log" class="chatlog" data-last="${lastId}" data-mine="ADMIN"
     data-poll="/admin/chat/\( {escapeHtml(user.user_id_code)}/poll"> \){log}</div>
<form method="post" class="row" style="margin-top:.75rem;flex-wrap:nowrap">
  <input type="hidden" name="csrf_token" value="${escapeHtml(ctx.csrfToken)}">
  <input name="message" maxlength="1000" placeholder="Répondre…" required style="margin:0">
  <button type="submit" style="flex:0 0 auto">Envoyer</button>
</form></div>${chatJs(ctx.nonce)}
<p><a style="color:var(--gold)" href="/admin/messages">← Retour</a></p>` });
}

function tplAdminIa(ctx, { error, answer, seconds, info }) {
  return page(ctx, { title: "Test IA", body: `
<div class="card"><h2>Test IA</h2>
${error ? `<div class="flash err"><b>❌</b> ${escapeHtml(error)}</div>`
        : `<div class="flash ok"><b>✅</b> ${escapeHtml(answer)}</div>`}
<p class="mut">Temps : ${seconds} s</p>
<p>Endpoint : ${escapeHtml(info.endpoint)} · Clé : ${info.hasKey ? "oui" : "non"}</p>
<p><a style="color:var(--gold)" href="/admin">← Retour</a></p></div>` });
}

function tplError(ctx, { code, msg }) {
  return page(ctx, { title: `Erreur ${code}`, body: `
<div class="card"><h2>Erreur \( {code}</h2><p> \){escapeHtml(msg)}</p>
<a href="/"><button>Accueil</button></a></div>` });
}

// =============================================================================
// HANDLER PRINCIPAL
// =============================================================================
export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const method = request.method;
    const path = url.pathname;
    const clientIp = request.headers.get("CF-Connecting-IP") || "unknown";
    const secure = env.TOUTBOT_COOKIE_SECURE === "1";
    const session = await loadSession(env, request);
    if (!session.data.csrf) {
      const arr = new Uint8Array(16);
      crypto.getRandomValues(arr);
      session.data.csrf = Array.from(arr).map(b => b.toString(16).padStart(2, "0")).join("");
    }
    const nonce = btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(12)))).replace(/=/g, "");
    let body = {}, json = {};

    try {
      if (method === "POST") {
        const ctype = (request.headers.get("content-type") || "").split(";")[0].trim();
        const raw = await request.arrayBuffer();
        if (raw.byteLength > MAX_CONTENT_LENGTH) throw new HttpAbort(413, ERROR_MESSAGES[413]);
        if (ctype === "application/json") {
          try { json = JSON.parse(new TextDecoder().decode(raw)); } catch { json = {}; }
        } else {
          body = Object.fromEntries(new URLSearchParams(new TextDecoder().decode(raw)));
        }
        const sent = body.csrf_token || request.headers.get("X-CSRF-Token") || "";
        if (!timingSafeEqualStr(sent, session.data.csrf)) throw new HttpAbort(400, ERROR_MESSAGES[400]);
      }

      const makeCtx = async () => {
        const me = await currentUser(env, session);
        const flashes = session.data.flashes || [];
        session.data.flashes = [];
        return { me, csrfToken: session.data.csrf, nonce, flashes, unreadDm: await unreadDmCount(env, me) };
      };

      const html = async (content, status = 200) => {
        await saveSession(env, session);
        const headers = new Headers({
          "Content-Type": "text/html; charset=utf-8",
          "Set-Cookie": sessionCookieHeader(session, secure),
          "Content-Security-Policy": `default-src 'self'; script-src 'nonce-${nonce}' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://www.youtube-nocookie.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'`,
          "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Cache-Control": "no-store",
        });
        if (secure) headers.set("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
        return new Response(content, { status, headers });
      };

      const jsonResp = async (obj, status = 200) => {
        await saveSession(env, session);
        return new Response(JSON.stringify(obj), {
          status,
          headers: { "Content-Type": "application/json", "Set-Cookie": sessionCookieHeader(session, secure) },
        });
      };

      const redirect = async (location, status = 302) => {
        await saveSession(env, session);
        return new Response(null, {
          status,
          headers: { Location: location, "Set-Cookie": sessionCookieHeader(session, secure) },
        });
      };

      async function currentUser(env, session) {
        const code = session.data.uid;
        if (!code) return null;
        const row = await one(env, "SELECT * FROM users WHERE user_id_code=?", [code]);
        if (!row) { delete session.data.uid; return null; }
        return row;
      }
      function flash(session, message, category = "ok") {
        session.data.flashes = session.data.flashes || [];
        session.data.flashes.push([category, message]);
      }
      async function unreadDmCount(env, user) {
        if (!user) return 0;
        const row = await one(env, "SELECT COUNT(*) AS n FROM direct_messages WHERE user_id_code=? AND read_by_user=0", [user.user_id_code]);
        return row ? row.n : 0;
      }

      const requireLogin = async () => {
        const me = await currentUser(env, session);
        if (!me) {
          if (path.startsWith("/api/")) throw new HttpAbort(401, ERROR_MESSAGES[401]);
          return redirect("/login");
        }
        return me;
      };

      const requireAdmin = async () => {
        const startedAt = session.data.adminAt || 0;
        if (!session.data.admin || Date.now() / 1000 - startedAt > 7200) {
          delete session.data.admin;
          return redirect("/admin/login");
        }
        return true;
      };

      // ========== ROUTES ==========
      if (path === "/" && method === "GET") {
        if (await currentUser(env, session)) return redirect("/chat");
        return html(tplHome(await makeCtx()));
      }

      if (path === "/register" && (method === "GET" || method === "POST")) {
        if (await currentUser(env, session)) return redirect("/chat");
        if (method === "POST") {
          if (!rateAllow(`reg:${clientIp}`, 5, 3600_000)) throw new HttpAbort(429, ERROR_MESSAGES[429]);
          const pseudo = (body.pseudo || "").trim();
          const password = body.password || "";
          if (!PSEUDO_RE.test(pseudo) && !PHONE_RE.test(pseudo)) flash(session, "Pseudo ou numéro invalide.", "err");
          else if (password.length < 8) flash(session, "Mot de passe trop court.", "err");
          else {
            try {
              const code = newCode("USR");
              const hash = await generatePasswordHash(password);
              await run(env, "INSERT INTO users (user_id_code, phone_or_pseudo, password_hash, created_at) VALUES (?, ?, ?, ?)",
                [code, pseudo, hash, nowIso()]);
              session.data = { uid: code, csrf: session.data.csrf };
              await audit(env, code, "REGISTER", pseudo);
              flash(session, "Compte créé. Bienvenue !", "ok");
              return redirect("/chat");
            } catch { flash(session, "Ce pseudo ou numéro est déjà pris.", "err"); }
          }
        }
        return html(tplAuth(await makeCtx(), { title: "Créer un compte", isRegister: true }));
      }

      if (path === "/login" && (method === "GET" || method === "POST")) {
        if (await currentUser(env, session)) return redirect("/chat");
        if (method === "POST") {
          if (!rateAllow(`login:${clientIp}`, 10, 600_000)) throw new HttpAbort(429, ERROR_MESSAGES[429]);
          const pseudo = (body.pseudo || "").trim();
          const password = body.password || "";
          const row = await one(env, "SELECT * FROM users WHERE phone_or_pseudo=?", [pseudo]);
          if (row && await checkPasswordHash(row.password_hash, password)) {
            session.data = { uid: row.user_id_code, csrf: session.data.csrf };
            await audit(env, row.user_id_code, "LOGIN", pseudo);
            return redirect("/chat");
          }
          flash(session, "Identifiants incorrects.", "err");
        }
        return html(tplAuth(await makeCtx(), { title: "Connexion", isRegister: false }));
      }

      if (path === "/logout" && method === "POST") {
        await clearSession(env, session);
        return redirect("/");
      }

      if (path === "/chat" && method === "GET") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const rows = (await all(env, "SELECT sender, message FROM chat_messages WHERE user_id_code=? ORDER BY id DESC LIMIT 20", [user.user_id_code])).reverse();
        return html(tplChat(await makeCtx(), { history: rows }));
      }

      if (path === "/api/chat" && method === "POST") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        if (!rateAllow(`chat:${user.user_id_code}`, 20, 60_000)) throw new HttpAbort(429, ERROR_MESSAGES[429]);
        const question = String(json.message || "").trim().slice(0, 2000);
        if (!question) return jsonResp({ error: "Message vide." }, 400);
        const rows = (await all(env, "SELECT sender, message FROM chat_messages WHERE user_id_code=? ORDER BY id DESC LIMIT 20", [user.user_id_code])).reverse();
        const history = rows.map(r => ({ role: r.sender === "USER" ? "user" : "assistant", content: r.message }));
        const results = await hybridSearch(env, question, user.user_id_code);
        const context = buildContext(results);
        let reply;
        try { reply = await aiAsk(env, history, question, context); }
        catch (e) { if (!(e instanceof AIUnavailable)) throw e; reply = fallbackReply(results); }
        const stamp = nowIso();
        await run(env, "INSERT INTO chat_messages (user_id_code, sender, message, created_at) VALUES (?, 'USER', ?, ?)", [user.user_id_code, question, stamp]);
        await run(env, "INSERT INTO chat_messages (user_id_code, sender, message, created_at) VALUES (?, 'BOT', ?, ?)", [user.user_id_code, reply, stamp]);
        return jsonResp({ reply, sources: publicSources(results) });
      }

      if (path === "/wallet" && method === "GET") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const txs = await all(env, "SELECT * FROM transactions WHERE user_id_code=? ORDER BY id DESC LIMIT 50", [user.user_id_code]);
        return html(tplWallet(await makeCtx(), { user, txs }));
      }

      if (path === "/wallet/deposit" && method === "POST") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        if (!rateAllow(`dep:${user.user_id_code}`, 10, 3600_000)) throw new HttpAbort(429, ERROR_MESSAGES[429]);
        try {
          const amount = parseAmount(body.amount);
          const phone = (body.phone || "").trim();
          if (!PHONE_RE.test(phone)) throw new BusinessError("Numéro invalide.");
          const ticket = await requestDeposit(env, user.user_id_code, amount, phone);
          await addDirectMessage(env, user.user_id_code, "SYSTEM", `Demande de dépôt ${ticket} de ${fmtFcfa(amount)}.`, "admin", ticket);
          flash(session, `Dépôt déclaré (${ticket}).`, "ok");
        } catch (e) { if (!(e instanceof BusinessError)) throw e; flash(session, e.message, "err"); }
        return redirect("/wallet");
      }

      if (path === "/wallet/withdraw" && method === "POST") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        if (!rateAllow(`wit:${user.user_id_code}`, 10, 3600_000)) throw new HttpAbort(429, ERROR_MESSAGES[429]);
        try {
          const amount = parseAmount(body.amount);
          const phone = (body.phone || "").trim();
          if (!PHONE_RE.test(phone)) throw new BusinessError("Numéro invalide.");
          const ticket = await requestWithdrawal(env, user.user_id_code, amount, phone);
          await addDirectMessage(env, user.user_id_code, "SYSTEM", `Demande de retrait ${ticket} de ${fmtFcfa(amount)}.`, "admin", ticket);
          flash(session, `Retrait demandé (${ticket}).`, "ok");
        } catch (e) { if (!(e instanceof BusinessError)) throw e; flash(session, e.message, "err"); }
        return redirect("/wallet");
      }

      if (path === "/wallet/tier" && method === "POST") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const tier = Number(body.tier || 0);
        if (!CONFIG.TIER_PRICES.includes(tier)) flash(session, "Prix invalide.", "err");
        else {
          await run(env, "UPDATE users SET tier_price=? WHERE user_id_code=?", [tier, user.user_id_code]);
          flash(session, "Prix mis à jour.", "ok");
        }
        return redirect("/wallet");
      }

      if (path === "/feed" && method === "GET") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const rows = await all(env,
          `SELECT p.*, u.phone_or_pseudo AS author FROM posts p JOIN users u ON u.user_id_code = p.user_id_code
           WHERE ${VISIBLE_POSTS_SQL} ORDER BY p.id DESC LIMIT 50`,
          [user.user_id_code, user.user_id_code, nowIso()]);
        return html(tplFeed(await makeCtx(), { posts: rows.map(withYoutube) }));
      }

      if (path === "/post" && method === "POST") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        if (!rateAllow(`post:${user.user_id_code}`, 15, 3600_000)) throw new HttpAbort(429, ERROR_MESSAGES[429]);
        const content = (body.content || "").trim().slice(0, 1000);
        let visibility = body.visibility || "PUBLIC";
        if (!CONFIG.POST_VISIBILITIES.includes(visibility)) visibility = "PUBLIC";
        if (!content) flash(session, "Message vide.", "err");
        else {
          await run(env, "INSERT INTO posts (user_id_code, content, visibility, created_at) VALUES (?, ?, ?, ?)",
            [user.user_id_code, content, visibility, nowIso()]);
          const row = await one(env, "SELECT id FROM posts WHERE user_id_code=? ORDER BY id DESC LIMIT 1", [user.user_id_code]);
          if (row) await storeInternal(env, row.id, content);
          flash(session, "Publication ajoutée.", "ok");
        }
        return redirect("/feed");
      }

      if (path === "/shorts" && method === "GET") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const rows = await all(env,
          `SELECT p.*, u.phone_or_pseudo AS author FROM posts p JOIN users u ON u.user_id_code = p.user_id_code
           WHERE ${VISIBLE_POSTS_SQL} ORDER BY p.id DESC LIMIT 30`,
          [user.user_id_code, user.user_id_code, nowIso()]);
        return html(tplShorts(await makeCtx(), { posts: rows.map(withYoutube).filter(p => p.yt) }));
      }

      if (path.startsWith("/creator/") && method === "GET") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const code = path.slice(9);
        const c = await one(env, "SELECT * FROM users WHERE user_id_code=?", [code]);
        if (!c) throw new HttpAbort(404, ERROR_MESSAGES[404]);
        const isOwner = user.user_id_code === code;
        const expires = isOwner ? null : await activeSubscription(env, user.user_id_code, code);
        const rows = await all(env,
          `SELECT p.*, u.phone_or_pseudo AS author FROM posts p JOIN users u ON u.user_id_code = p.user_id_code
           WHERE p.user_id_code=? AND ${VISIBLE_POSTS_SQL} ORDER BY p.id DESC LIMIT 30`,
          [code, user.user_id_code, user.user_id_code, nowIso()]);
        let locked = 0;
        if (!isOwner && !expires) {
          const lr = await one(env, "SELECT COUNT(*) AS n FROM posts WHERE user_id_code=? AND visibility='ABONNES'", [code]);
          locked = lr ? lr.n : 0;
        }
        if (!isOwner) await run(env, "UPDATE users SET views_count = views_count + 1 WHERE user_id_code=?", [code]);
        return html(tplCreator(await makeCtx(), { creator: c, posts: rows.map(withYoutube), isOwner, expires, locked, days: CONFIG.SUBSCRIPTION_DAYS }));
      }

      if (path.startsWith("/subscribe/") && method === "POST") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const code = path.slice(11);
        try {
          const expires = await subscribeTo(env, user.user_id_code, code);
          flash(session, `Abonnement actif jusqu'au ${expires}.`, "ok");
        } catch (e) { if (!(e instanceof BusinessError)) throw e; flash(session, e.message, "err"); }
        return redirect(`/creator/${code}`);
      }

      if (path === "/support" && (method === "GET" || method === "POST")) {
        const user = await requireLogin(); if (user instanceof Response) return user;
        if (method === "POST") {
          const ticket = (body.ticket || "").trim().slice(0, 20);
          let issue = body.issue || "AUTRE";
          const message = (body.message || "").trim().slice(0, 1000);
          if (!ISSUE_TYPES.includes(issue)) issue = "AUTRE";
          if (message.length < 10) flash(session, "Message trop court.", "err");
          else {
            await run(env, "INSERT INTO support_tickets (user_id_code, tx_ticket_code, issue_type, message, created_at) VALUES (?, ?, ?, ?, ?)",
              [user.user_id_code, ticket, issue, message, nowIso()]);
            flash(session, "Demande envoyée.", "ok");
            return redirect("/support");
          }
        }
        const tickets = await all(env, "SELECT * FROM support_tickets WHERE user_id_code=? ORDER BY id DESC LIMIT 20", [user.user_id_code]);
        return html(tplSupport(await makeCtx(), { tickets }));
      }

      if (path === "/search" && method === "GET") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const q = (url.searchParams.get("q") || "").trim().slice(0, 200);
        const results = q ? await searchInternal(env, q, user.user_id_code, 20) : [];
        return html(tplSearch(await makeCtx(), { q, results }));
      }

      if (path === "/messages" && (method === "GET" || method === "POST")) {
        const user = await requireLogin(); if (user instanceof Response) return user;
        if (method === "POST") {
          const msg = (body.message || "").trim().slice(0, 1000);
          if (msg) await addDirectMessage(env, user.user_id_code, "USER", msg, "admin");
          return redirect("/messages");
        }
        await run(env, "UPDATE direct_messages SET read_by_user=1 WHERE user_id_code=? AND read_by_user=0", [user.user_id_code]);
        const rows = await all(env, "SELECT * FROM direct_messages WHERE user_id_code=? ORDER BY id ASC LIMIT 200", [user.user_id_code]);
        const lastId = rows.length ? rows[rows.length - 1].id : 0;
        return html(tplMessages(await makeCtx(), { messages: rows, lastId }));
      }

      if (path === "/messages/poll" && method === "GET") {
        const user = await requireLogin(); if (user instanceof Response) return user;
        const after = Number(url.searchParams.get("after") || 0);
        const rows = await all(env, "SELECT id, sender, message, created_at FROM direct_messages WHERE user_id_code=? AND id > ? ORDER BY id ASC LIMIT 50", [user.user_id_code, after]);
        if (rows.length) await run(env, "UPDATE direct_messages SET read_by_user=1 WHERE user_id_code=? AND id > ? AND read_by_user=0", [user.user_id_code, after]);
        return jsonResp(rows);
      }

      // Admin
      const adminPassword = env.TOUTBOT_ADMIN_PASSWORD || "Numberone_100_ans";

      if (path === "/admin/login" && (method === "GET" || method === "POST")) {
        if (method === "POST") {
          if (!rateAllow(`admin:${clientIp}`, 8, 600_000)) throw new HttpAbort(429, ERROR_MESSAGES[429]);
          if (timingSafeEqualStr(body.password || "", adminPassword)) {
            session.data.admin = true;
            session.data.adminAt = Date.now() / 1000;
            return redirect("/admin");
          }
          flash(session, "Mot de passe incorrect.", "err");
        }
        return html(tplAdminLogin(await makeCtx()));
      }

      if (path === "/admin/logout" && method === "POST") {
        delete session.data.admin; delete session.data.adminAt;
        return redirect("/admin/login");
      }

      if (path === "/admin" && method === "GET") {
        const ok = await requireAdmin(); if (ok instanceof Response) return ok;
        const stats = {
          users: (await one(env, "SELECT COUNT(*) AS n FROM users")).n,
          total: (await one(env, "SELECT COALESCE(SUM(balance),0) AS s FROM users")).s,
          pending: (await one(env, "SELECT COUNT(*) AS n FROM transactions WHERE status='EN_ATTENTE'")).n,
        };
        const pending = await all(env, "SELECT * FROM transactions WHERE status='EN_ATTENTE' ORDER BY id ASC LIMIT 50");
        return html(tplAdminDashboard(await makeCtx(), { stats, pending }));
      }

      if (path.match(/^\/admin\/tx\/\d+\/(approve|reject)$/) && method === "POST") {
        const ok = await requireAdmin(); if (ok instanceof Response) return ok;
        const parts = path.split("/");
        const id = Number(parts[3]), action = parts[4];
        try {
          const ticket = await decideTransaction(env, id, action === "approve");
          flash(session, `Transaction ${ticket} traitée.`, "ok");
        } catch (e) { if (!(e instanceof BusinessError)) throw e; flash(session, e.message, "err"); }
        return redirect("/admin");
      }

      if (path === "/admin/messages" && method === "GET") {
        const ok = await requireAdmin(); if (ok instanceof Response) return ok;
        const rows = await all(env, `
          SELECT u.user_id_code, u.phone_or_pseudo,
            (SELECT COUNT(*) FROM direct_messages d WHERE d.user_id_code=u.user_id_code AND d.read_by_admin=0) AS unread
          FROM users u WHERE EXISTS (SELECT 1 FROM direct_messages d WHERE d.user_id_code=u.user_id_code)
          ORDER BY unread DESC, u.phone_or_pseudo`);
        return html(tplAdminMessages(await makeCtx(), { users: rows }));
      }

      if (path.match(/^\/admin\/chat\/[^/]+$/) && (method === "GET" || method === "POST")) {
        const ok = await requireAdmin(); if (ok instanceof Response) return ok;
        const code = path.slice(12);
        const user = await one(env, "SELECT * FROM users WHERE user_id_code=?", [code]);
        if (!user) throw new HttpAbort(404, ERROR_MESSAGES[404]);
        if (method === "POST") {
          const msg = (body.message || "").trim().slice(0, 1000);
          if (msg) await addDirectMessage(env, code, "ADMIN", msg, "user");
          return redirect(`/admin/chat/${code}`);
        }
        await run(env, "UPDATE direct_messages SET read_by_admin=1 WHERE user_id_code=? AND read_by_admin=0", [code]);
        const rows = await all(env, "SELECT * FROM direct_messages WHERE user_id_code=? ORDER BY id ASC LIMIT 200", [code]);
        const lastId = rows.length ? rows[rows.length - 1].id : 0;
        return html(tplAdminChat(await makeCtx(), { user, messages: rows, lastId }));
      }

      if (path.match(/^\/admin\/chat\/[^/]+\/poll$/) && method === "GET") {
        const ok = await requireAdmin(); if (ok instanceof Response) return ok;
        const code = path.split("/")[3];
        const after = Number(url.searchParams.get("after") || 0);
        const rows = await all(env, "SELECT id, sender, message, created_at FROM direct_messages WHERE user_id_code=? AND id > ? ORDER BY id ASC LIMIT 50", [code, after]);
        if (rows.length) await run(env, "UPDATE direct_messages SET read_by_admin=1 WHERE user_id_code=? AND id > ? AND read_by_admin=0", [code, after]);
        return jsonResp(rows);
      }

      if (path === "/admin/ia" && method === "GET") {
        const ok = await requireAdmin(); if (ok instanceof Response) return ok;
        const start = Date.now();
        let error = null, answer = null;
        try { answer = await aiAsk(env, [], "Dis juste « OK » si tu fonctionnes."); }
        catch (e) { if (e instanceof AIUnavailable) error = e.message; else throw e; }
        return html(tplAdminIa(await makeCtx(), {
          error, answer, seconds: ((Date.now() - start) / 1000).toFixed(2),
          info: { endpoint: env.POLLINATIONS_KEY ? "gen.pollinations.ai" : "text.pollinations.ai", hasKey: !!(env.POLLINATIONS_KEY || "").trim() },
        }));
      }

      throw new HttpAbort(404, ERROR_MESSAGES[404]);

    } catch (err) {
      const status = err instanceof HttpAbort ? err.status : 500;
      const message = err instanceof HttpAbort ? err.message : "Erreur interne.";
      if (!(err instanceof HttpAbort)) console.error(err);
      await saveSession(env, session).catch(() => {});
      if (path.startsWith("/api/")) {
        return new Response(JSON.stringify({ error: message }), { status, headers: { "Content-Type": "application/json" } });
      }
      const ctxErr = { me: null, csrfToken: session.data.csrf || "", nonce: "", flashes: [], unreadDm: 0 };
      return new Response(tplError(ctxErr, { code: status, msg: message }), {
        status, headers: { "Content-Type": "text/html; charset=utf-8" },
      });
    }
  },
};
